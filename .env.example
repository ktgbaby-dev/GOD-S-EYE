# GOD'S EYE configuration. Copy to .env for local use (or run: python app.py --init).
# .env is git-ignored. On Vercel, add these under Project -> Settings -> Environment Variables.
# None of these values ever reach the browser.

# --- Required -------------------------------------------------------------------------------
# OG-WAN's password (10+ characters). The only way into the app.
GODS_EYE_PASSWORD=
# 32+ random characters; keys the session-token hashes. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# --- Database -------------------------------------------------------------------------------
# Locally: a SQLite file at data/gods_eye.db (override with GODS_EYE_DB_PATH).
# On Vercel: REQUIRED. Connect a Neon Postgres database (Storage tab) and Vercel sets DATABASE_URL for you.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# GODS_EYE_DB_PATH=data/gods_eye.db

# --- Daily drop (Vercel Cron) ---------------------------------------------------------------
# Vercel sends this as a Bearer token to /api/cron/daily-drop. Without it the cron endpoint refuses to run.
CRON_SECRET=

# --- Discovery sources (optional; Audius needs no key) ---------------------------------------
# YouTube Data API v3 key: console.cloud.google.com -> enable "YouTube Data API v3" -> Credentials -> API key.
YOUTUBE_API_KEY=
# Instagram + TikTok discovery through search results. Set ONE of these:
# Serper (Google results): https://serper.dev
SERPER_API_KEY=
# Brave Search API: https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=
# Name sent to the Audius API as app_name (optional).
# AUDIUS_APP_NAME=GodsEye

# --- Cookies --------------------------------------------------------------------------------
# Defaults to 1 on Vercel (HTTPS). Set 1 on any other HTTPS host.
# SECURE_COOKIES=0
